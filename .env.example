# Theatarr Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED
# =============================================================================

# Secret key for JWT signing (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32

# =============================================================================
# DATABASE
# =============================================================================

# SQLite database path (relative to DATA_PATH)
DATABASE_URL=sqlite:///./data/theatarr.db

# =============================================================================
# AUTHENTICATION
# =============================================================================

# JWT algorithm (HS256 recommended)
JWT_ALGORITHM=HS256

# Access token expiration in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================

# TMDB API key for movie metadata and trailer discovery
# Get one at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# =============================================================================
# STORAGE
# =============================================================================

# Base data directory (used by Docker volume)
DATA_PATH=/data

# Trailer storage path
TRAILER_PATH=/data/trailers

# =============================================================================
# SERVER
# =============================================================================

# Backend port (default: 8080)
BACKEND_PORT=8080

# Frontend port (default: 3000)
FRONTEND_PORT=3000

# Frontend API URL (for Docker: use backend service name)
VITE_API_URL=http://localhost:8080

# Debug mode (enables hot reload and verbose logging)
DEBUG=true

# =============================================================================
# WALLMOUNT & VOTE SETTINGS
# =============================================================================

# Wallmount requires authentication token (default: false for public access)
WALLMOUNT_REQUIRES_TOKEN=false

# Vote token expiration in hours (default: 24)
VOTE_TOKEN_EXPIRY_HOURS=24

# =============================================================================
# SESSION SETTINGS
# =============================================================================

# Auto-resume sessions after system restart (default: true)
AUTO_RESUME_SESSIONS=true
